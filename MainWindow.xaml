<Window x:Class="DevStarter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DevStarter.Converters"
        Title="devStarter"
        Width="268" Height="600" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        AllowDrop="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibleConverter x:Key="NullToVisible"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Alt çubuk düğmeleri (+ Yeni proje, görünüm, menü) -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="11" BorderBrush="#30FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#16FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#34FFFFFF" Offset="0"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="B" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kart üzerindeki küçük ✎ / ⋯ düğmeleri -->
        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7" Background="#22FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="VPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <Style x:Key="VItem" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="HItem" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- Proje ikonunun üzerine gelince büyüme (Wsidebar'dan) -->
        <Style x:Key="HoverScale" TargetType="Grid">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.13"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.13"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF"/>
                    <Setter Property="BorderBrush" Value="#38FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Açılırken dönen simge -->
        <Style x:Key="Spinner" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE895;"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Proje araç ipucu: ad + hedefler -->
        <DataTemplate x:Key="ProjectTip">
            <StackPanel MinWidth="170" MaxWidth="380">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16" Height="16">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}" Margin="7,0,0,0" Foreground="#D8FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Error}" Foreground="#FFFF8A8A" Margin="23,1,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Tıkla: hepsini aç  •  Sağ tık: menü" Foreground="#70FFFFFF" FontSize="11" Margin="0,7,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- İkon modu: renkli baş harf rozeti -->
        <DataTemplate x:Key="IconTemplate">
            <Grid x:Name="ItemRoot" Width="48" Height="52" Background="Transparent" Cursor="Hand" Style="{StaticResource HoverScale}"
                  MouseLeftButtonUp="Item_Click" MouseRightButtonUp="Item_RightClick"
                  AllowDrop="True" DragOver="Item_DragOver" Drop="Item_Drop"
                  ToolTipService.InitialShowDelay="250">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource ProjectTip}"/>
                </Grid.ToolTip>
                <Border Width="44" Height="44" CornerRadius="13" Background="{Binding Brush}"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconImage}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}"/>
                        <Border CornerRadius="12" Background="#8C000000"
                                Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Spinner}" FontSize="16"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFACC15"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                <Ellipse Width="11" Height="11" Fill="#FFE5484D" Stroke="#FF1B1B20" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                         Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                <!-- Üzerine gelince: düzenle rozeti -->
                <Border x:Name="EditBadge" Width="19" Height="19" CornerRadius="9.5" Background="#F02A2A31"
                        BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-1,1" Visibility="Collapsed" ToolTip="Düzenle" MouseLeftButtonUp="IconEdit_Click">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="EditBadge" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kart modu: ad + bağlı uygulama ikonları -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Width="230" Height="54" CornerRadius="11" Padding="8,0,8,0" BorderThickness="1" Cursor="Hand"
                    Style="{StaticResource CardStyle}" RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonUp="Item_Click" MouseRightButtonUp="Item_RightClick"
                    AllowDrop="True" DragOver="Item_DragOver" Drop="Item_Drop">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{Binding Brush}">
                        <Grid>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding IconImage}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}"/>
                            <Border CornerRadius="10" Background="#8C000000"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Spinner}" FontSize="14"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding Targets}" Margin="0,4,0,0" Height="16" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="16" Height="16" Margin="0,0,6,0" Background="Transparent"
                                          ToolTip="{Binding Summary}" MouseLeftButtonUp="TargetIcon_Click">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#D0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/>
                                        <Ellipse Width="7" Height="7" Fill="#FFE5484D" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,-2,-1" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <TextBlock x:Name="Star" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#FFFACC15" VerticalAlignment="Top" Margin="0,9,0,0"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                        <!-- Üzerine gelince: düzenle / menü -->
                        <StackPanel x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Button Style="{StaticResource CardActionButton}" Content="&#xE70F;" ToolTip="Düzenle"
                                    Click="CardEdit_Click"/>
                            <Button Style="{StaticResource CardActionButton}" Content="&#xE712;" ToolTip="Diğer: sil, simge, favori, sadece…"
                                    Click="CardMore_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Star" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Host">
        <Border x:Name="Root" Padding="6" BorderThickness="1" BorderBrush="#30FFFFFF" ClipToBounds="True"
                MouseRightButtonUp="Root_RightClick">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F22B2B33" Offset="0"/>
                    <GradientStop Color="#EA15151B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <DockPanel x:Name="Body" LastChildFill="True">
                <Grid x:Name="SearchHost" DockPanel.Dock="Top" Height="32">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" FontSize="12.5"
                             Foreground="#F0FFFFFF" CaretBrush="#F0FFFFFF" SelectionBrush="#5C0078D4"
                             Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                             Padding="0" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="30,0,8,0" Padding="0" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#80FFFFFF"
                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Proje ara…" FontSize="12.5" Foreground="#70FFFFFF"
                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Alt çubuk: + Yeni proje, görünüm (kart ⇄ ikon), menü -->
                <StackPanel x:Name="Footer" DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button x:Name="AddButton" Style="{StaticResource BarButton}" Click="AddClick" ToolTip="Proje ekle" FontSize="13"/>
                    <StackPanel x:Name="SmallButtons" Orientation="Horizontal">
                        <Button x:Name="ViewButton" Style="{StaticResource BarButton}" Click="ViewToggle_Click"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        <Button x:Name="MenuButton" Style="{StaticResource BarButton}" Click="MenuButton_Click" Content="&#xE712;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                ToolTip="Ayarlar: konum, görünüm, otomatik gizle, çıkış…"/>
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
                        <ItemsControl x:Name="ProjectList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" FontSize="11.5" Foreground="#78FFFFFF" TextAlignment="Center" LineHeight="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14"
                               IsHitTestVisible="False" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <Border x:Name="Handle" CornerRadius="2" Background="#A8FFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Popup x:Name="Toast" AllowsTransparency="True" StaysOpen="True" PlacementTarget="{Binding ElementName=Root}"
               Placement="Left" PopupAnimation="Fade">
            <Border x:Name="ToastBorder" Margin="10" CornerRadius="12" Background="#F5202026" BorderBrush="#30FFFFFF"
                    BorderThickness="1" Padding="14,10" MaxWidth="380" MouseLeftButtonUp="Toast_Click" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="13" Foreground="#F2FFFFFF"/>
                    <TextBlock x:Name="ToastBody" FontSize="12" Foreground="#C8FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
