<Window x:Class="DevStarter.Views.AgentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajanlar ve limitler — devStarter" Width="620" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Bir ajan oturumu satırı -->
        <DataTemplate x:Key="SessionTemplate">
            <Border x:Name="Row" CornerRadius="10" Padding="11,9" Margin="0,3" BorderThickness="1"
                    Background="#0DFFFFFF" BorderBrush="#14FFFFFF" Cursor="Hand"
                    MouseLeftButtonUp="Session_Click" ToolTip="Tıkla: oturumun penceresini öne getir">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{Binding KindBrush}" VerticalAlignment="Top"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <TextBlock Text="{Binding KindGlyph}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Symbol, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,10,0">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="12" Foreground="#B0FFFFFF"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#60FFFFFF"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Top" Background="#14FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11.5"
                                       FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#18FFFFFF"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="#38FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1AFACC15"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="#80FACC15"/>
                    <Setter TargetName="DetailText" Property="Foreground" Value="#FFFDE68A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,8,18,16">
        <TabControl x:Name="Tabs">
            <!-- ================= Ajanlar ================= -->
            <TabItem Header="Ajanlar">
                <DockPanel Margin="0,14,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SummaryParts" FontSize="12" Opacity="0.7" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="KindFilter" Width="132" SelectionChanged="Filter_Changed"/>
                            <ToggleButton x:Name="WaitingOnly" Content="Sadece bekleyenler" Margin="8,0,0,0" Click="Filter_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ProjectChip" DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="13"
                            Background="#22FFFFFF" Padding="11,3,4,3" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProjectChipText" VerticalAlignment="Center" FontSize="12"/>
                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                    Padding="6,4" Margin="6,0,0,0" Click="ClearProject_Click" ToolTip="Tüm projeleri göster"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SourcesHint" DockPanel.Dock="Bottom" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                               Margin="2,10,0,0"/>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SessionList" ItemTemplate="{StaticResource SessionTemplate}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,12,0,3">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.75"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="12" Opacity="0.45"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Opacity="0.6" TextWrapping="Wrap" MaxWidth="360" LineHeight="19" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Limitler ================= -->
            <TabItem x:Name="UsageTab" Header="Limitler">
                <DockPanel Margin="0,14,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kullanım limitleri" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UsageInfo" FontSize="12" Opacity="0.6" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="RefreshUsageButton" Grid.Column="1" Click="RefreshUsage_Click" VerticalAlignment="Center"
                                ToolTip="Hepsini şimdi yeniden oku">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Yenile" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="UsageList" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="13,11" Margin="0,4" Background="#0DFFFFFF"
                                            BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{Binding Brush}"
                                                        BorderBrush="#30FFFFFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI Symbol, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Background="#1EFFFFFF" VerticalAlignment="Center"
                                                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Plan}" FontSize="11" FontWeight="SemiBold" Opacity="0.85"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" Opacity="0.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Meters}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,9,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding BarBrush}" Margin="10,0,0,0"/>
                                                            </Grid>
                                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" MinHeight="6"
                                                                         Margin="0,5,0,0" Foreground="{Binding BarBrush}" Background="#1FFFFFFF"/>
                                                            <TextBlock Text="{Binding ResetText}" FontSize="11.5" Opacity="0.55" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="#FFFBBF24" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= Bağlantılar ================= -->
            <TabItem x:Name="LinksTab" Header="Bağlantılar">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Ajan bağlantıları" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,8" LineHeight="17"
                                   Text="Claude Code ek ayar gerektirmez. Codex, Gemini ve OpenCode'un durumlarını devStarter'a bildirmesi için ayar dosyalarına küçük bir hook (OpenCode'da eklenti) eklenir. Değiştirilen dosya önce yedeklenir; Kaldır ile yalnızca devStarter'ın eklediği kısım silinir."/>
                        <ItemsControl x:Name="LinkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,10" Margin="0,4" Background="#0DFFFFFF"
                                            BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{Binding KindBrush}" VerticalAlignment="Top"
                                                    BorderBrush="#30FFFFFF" BorderThickness="1">
                                                <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI Symbol, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="9" Padding="7,1" Margin="8,0,0,0" Background="#14FFFFFF" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                                                       FontWeight="SemiBold" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,0" LineHeight="17"/>
                                                <TextBlock Text="{Binding LastEventText}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.55" Margin="0,4,0,0"
                                                           Visibility="{Binding HasLastEventText, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding ActionText}" VerticalAlignment="Top" MinWidth="76"
                                                    Click="LinkAction_Click" Visibility="{Binding CanAct, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Yerel köprü" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,4"/>
                        <TextBlock x:Name="HookStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>

                        <TextBlock Text="Bildirimler" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <CheckBox x:Name="NotifyWaiting" Content="Bir ajan izin ya da yanıt beklemeye başlayınca bildir" Click="Notify_Changed"/>
                        <CheckBox x:Name="NotifyFinished" Content="Bir ajan 30 saniyeden uzun süren işini bitirince bildir" Click="Notify_Changed"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
